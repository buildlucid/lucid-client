---
import Scenario from "../../components/Scenario.astro";
import Playground from "../../layouts/Playground.astro";
import { targetLinks } from "../../scripts/speculate-links";

const matrix = targetLinks.filter((link) => link.id <= 10);
const scrollLink = targetLinks.find((link) => link.id === 11)!;
const controlLink = targetLinks.find((link) => link.id === 12)!;
const lateLink = targetLinks.find((link) => link.id === 13)!;

const supportRows = [
	["rules", "Speculation Rules"],
	["link", '<link rel="prefetch">'],
	["path", "Path Speculate takes"],
	["online", "Network"],
	["save-data", "Save-Data"],
	["effective-type", "Effective connection type"],
	["will-run", "Speculate will initialise"],
];

const statusClass =
	"text-xs text-subtle data-[speculated=true]:text-emerald-300";
---

<Playground title="Speculate">
	<Fragment slot="intro">
		<p>
			<code>speculate.init()</code> prefetches or prerenders links from their
			<code>data-speculate</code> attributes, using Speculation Rules where the browser supports them
			and <code>&lt;link rel="prefetch"&gt;</code> or a low-priority
			<code>fetch</code> where it doesn't.
		</p>
		<p>
			Every link goes to a target page that reports how it was loaded. The
			fallbacks rely on HTTP caching, so check those against a server that
			sends cache headers.
		</p>
	</Fragment>

	<Scenario
		id="support"
		title="Browser support"
		description="The same checks Speculate makes. They decide which path it takes and whether it runs at all: it skips offline visitors, Save-Data and 2G or 3G connections."
		expect={[
			"Chrome and Edge report Speculation Rules as supported; Firefox reports only link prefetch; Safari reports neither and uses `fetch`.",
			"`Speculate will initialise` is `Yes` on a normal connection.",
		]}
		markup={false}
	>
		<dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
			{
				supportRows.map(([key, label]) => (
					<div class="flex items-center justify-between gap-3 border-b border-line/60 py-1.5">
						<dt class="text-muted">{label}</dt>
						<dd
							class="badge data-[ok=false]:border-rose-400/30 data-[ok=false]:text-rose-300 data-[ok=true]:border-emerald-400/30 data-[ok=true]:text-emerald-300"
							data-support={key}
						>
							…
						</dd>
					</div>
				))
			}
		</dl>
	</Scenario>

	<Scenario
		id="links"
		title="Every action and trigger"
		description="One link per action and trigger. `Resolves to` is what Speculate uses in this browser after its fallbacks; `Added` shows the rule, prefetch link or fetch Speculate added for the link. A rule only registers the link: the browser decides when to speculate it from its eagerness."
		expect={[
			"With Speculation Rules, every row except the `visible` ones gets its rule once the browser is idle, in one rule set. `immediate` rows are speculated straight away. On desktop the others wait for hover or a press, as their eagerness says; Chrome on Android can also start `eager` and `moderate` ones from what is in view.",
			"The `visible` rows stay `Waiting` until the table scrolls into view, then they are speculated.",
			"Without Speculation Rules, `prerender` resolves to `prefetch` and every trigger except `visible` resolves to `moderate`: resting the pointer on a link for 200ms, pressing it or focusing it prefetches it, and moving off it sooner doesn't.",
			"Opening a prerendered link shows `Prerendered` on the target page; a prefetched one shows `Prefetched`.",
		]}
	>
		<div class="-mx-1 overflow-x-auto">
			<table class="w-full min-w-[34rem] text-left text-sm">
				<thead class="text-xs text-subtle">
					<tr>
						<th class="px-1 pb-2 font-medium">Link</th>
						<th class="px-1 pb-2 font-medium">Attribute</th>
						<th class="px-1 pb-2 font-medium">Resolves to</th>
						<th class="px-1 pb-2 font-medium">Added</th>
					</tr>
				</thead>
				<tbody>
					{
						matrix.map((link) => (
							<tr class="border-t border-line/60">
								<td class="px-1 py-2">
									<a href={link.href} {...link.attributes}>
										Target {link.id}
									</a>
									<span class="block text-xs text-subtle">{link.note}</span>
								</td>
								<td class="px-1 py-2 font-mono text-xs">{link.markup}</td>
								<td class="px-1 py-2 text-xs text-muted" data-effective={link.id} />
								<td class={`px-1 py-2 ${statusClass}`} data-status={link.id}>
									Waiting
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</Scenario>

	<Scenario
		id="visible-trigger"
		title="The visible trigger inside a scroll container"
		description={`Target ${scrollLink.id} uses \`${scrollLink.markup}\` and sits below the fold of a scrolling box. Target ${controlLink.id} has no \`data-speculate\` attribute, as a control.`}
		expect={[
			`Target ${scrollLink.id} stays \`Waiting\` until the box is scrolled to it, then it is speculated.`,
			`Target ${controlLink.id} is never speculated, and its target page reports a network load.`,
		]}
	>
		<div class="grid gap-4 sm:grid-cols-[1fr_auto] sm:items-start">
			<div class="h-36 overflow-y-auto rounded-md border border-line bg-raised/50 px-4" tabindex="0" aria-label="Scrolling box">
				<p class="pt-4 text-sm text-subtle">Scroll down inside this box.</p>
				<div class="h-56"></div>
				<p class="pb-4 text-sm">
					<a href={scrollLink.href} {...scrollLink.attributes}>Target {scrollLink.id}</a>
					<span class="ml-2 font-mono text-xs text-subtle">{scrollLink.markup}</span>
				</p>
			</div>
			<dl class="space-y-2 text-sm sm:w-56">
				<div class="flex justify-between gap-3">
					<dt class="text-muted">Target {scrollLink.id}</dt>
					<dd class={statusClass} data-status={scrollLink.id}>Waiting</dd>
				</div>
				<div class="flex justify-between gap-3">
					<dt><a href={controlLink.href}>Target {controlLink.id}</a></dt>
					<dd class={statusClass} data-status={controlLink.id}>Waiting</dd>
				</div>
			</dl>
		</div>
	</Scenario>

	<Scenario
		id="refresh"
		title="Links added after init"
		description={`\`Add link\` adds Target ${lateLink.id}, which uses \`${lateLink.markup}\`, after \`init\`. \`refresh()\` picks it up.`}
		expect={[
			`With Speculation Rules, Target ${lateLink.id} stays \`Waiting\` once it is added, and is speculated after \`Refresh\`, in a rule set of its own.`,
			`Without Speculation Rules, \`immediate\` falls back to \`moderate\`, which reads intent from the whole page, so Target ${lateLink.id} is prefetched on hover without \`Refresh\`.`,
			"Pressing `Refresh` again adds nothing, as the same rule is only added once.",
		]}
	>
		<div class="space-y-3">
			<div class="flex flex-wrap items-center gap-2">
				<button class="btn" data-late-add>Add link</button>
				<button class="btn btn-ghost" data-late-refresh>Refresh</button>
				<span class="ml-auto text-xs text-subtle">
					Target {lateLink.id}:
					<span class={statusClass} data-status={lateLink.id}>Waiting</span>
				</span>
			</div>
			<p class="min-h-6 text-sm" data-late-slot></p>
			<template data-late-template>
				<a href={lateLink.href} {...lateLink.attributes}>Target {lateLink.id}</a>
			</template>
		</div>
	</Scenario>

	<Scenario
		id="skipped"
		title="Links it leaves out"
		description={`Each of these has \`data-speculate="immediate"\`, but can't be speculated. The development build warns about each one in the console, apart from the links to this page.`}
		expect={[
			"None of them appear in the head view below.",
			"The console warns that the first link goes to another origin, the second opens in another tab or window, the third downloads a file and the button isn't a link.",
			"The link to this page and its `#links` hash are left out without a warning.",
		]}
	>
		<ul class="space-y-2 text-sm">
			<li><a href="https://example.com/" data-speculate="immediate">Another origin</a></li>
			<li><a href="/speculate/target/1?tab=new" target="_blank" data-speculate="immediate">A new tab</a></li>
			<li><a href="/favicon.svg" download data-speculate="immediate">A download</a></li>
			<li><button class="btn btn-sm" data-speculate="immediate">A button</button></li>
			<li><a href="/speculate" data-speculate="immediate">This page</a></li>
			<li><a href="/speculate#links" data-speculate="immediate">This page, with a hash</a></li>
		</ul>
	</Scenario>

	<Scenario
		id="injected"
		title="What Speculate adds to the head"
		description={'A live view of the `<script type="speculationrules">` and `<link rel="prefetch">` elements Speculate adds, marked with `data-speculate--generated`. `destroy()` removes them.'}
		expect={[
			"With Speculation Rules, the links set up together share one script, and `visible` links that scroll into view together share another.",
			"Without Speculation Rules, there is one `<link rel=\"prefetch\">` per prefetched page.",
			"`Destroy` empties the view and resets every `Added` status to `Waiting`.",
			"`Initialise again` adds them back.",
		]}
		markup={false}
	>
		<div class="space-y-3">
			<div class="flex flex-wrap items-center gap-2">
				<button class="btn btn-danger" data-links-action="destroy">Destroy</button>
				<button class="btn" data-links-action="init">Initialise again</button>
				<span class="ml-auto flex items-center gap-2 text-xs text-subtle">
					<span class="badge font-mono tabular-nums" data-injected-count>0</span>
					elements
					<span
						class="badge data-[running=false]:border-rose-400/30 data-[running=false]:text-rose-300 data-[running=true]:border-emerald-400/30 data-[running=true]:text-emerald-300"
						data-links-state
					>
						initialised
					</span>
				</span>
			</div>
			<pre class="readout max-h-80 overflow-auto" data-injected>Nothing injected yet.</pre>
		</div>
	</Scenario>

	<script>
		import "../../scripts/speculate";
	</script>
</Playground>

---
import Scenario from "../components/Scenario.astro";
import Playground from "../layouts/Playground.astro";

const categories = [
	{
		key: "essential",
		title: "Essential",
		description: "Needed for the site to work, including remembering these choices. Always on.",
		cookies: "CookieController, session",
	},
	{
		key: "analytics",
		title: "Analytics",
		description: "Helps us understand how the site is used.",
		cookies: "_ga, _gid",
	},
	{
		key: "marketing",
		title: "Marketing",
		description: "Lets embedded media and ad partners personalise what you see.",
		cookies: "_fbp, mkto",
	},
];

const statusPill =
	"rounded-full px-2 py-0.5 text-[11px] font-semibold data-[granted=true]:bg-emerald-400/15 data-[granted=true]:text-emerald-300 data-[granted=false]:bg-rose-400/10 data-[granted=false]:text-rose-300";
const gatePill =
	"rounded-full bg-raised px-2 py-0.5 text-[11px] font-semibold text-subtle data-[ran=true]:bg-emerald-400/15 data-[ran=true]:text-emerald-300";
---

<Playground title="Cookie Controller">
	<Fragment slot="intro">
		<p>
			Cookie Controller brings no markup or styles: the banner and dialog below
			are wired up entirely with <code>data-cookie--*</code> attributes, and a
			Catalyst store follows the same consent. This
			page runs on policy version
			<code data-consent-policy>1.0.2</code>. Every consent change is logged
			with its full payload.
		</p>
	</Fragment>

	<Scenario
		id="status"
		title="Consent status"
		description="What `getConsent()` returns for each category, the type of the last `onConsentChange`, and the preference cookie as stored."
		expect={[
			"On a first visit every optional category is denied, the type is `load` and there is no cookie.",
			"After a decision, the pills, the change type and the cookie update together.",
			"`Clear cookie and reload` brings the banner back, as for a first visit.",
		]}
		markup={false}
	>
		<div class="space-y-4">
			<div class="grid gap-2 sm:grid-cols-3">
				{
					categories.map((category) => (
						<div class="flex items-center justify-between rounded-md bg-raised px-3 py-2.5">
							<span class="text-sm">{category.title}</span>
							<span class={statusPill} data-consent-pill={category.key}>…</span>
						</div>
					))
				}
			</div>
			<dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-1.5 text-[13px]">
				<dt class="text-subtle">Last change</dt>
				<dd class="font-mono" data-consent-type>—</dd>
				<dt class="text-subtle">UUID</dt>
				<dd class="truncate font-mono text-muted" data-consent-uuid>—</dd>
			</dl>
			<div class="space-y-1.5">
				<p class="text-[11px] font-medium tracking-wide text-subtle uppercase">Preference cookie</p>
				<pre class="readout max-h-60 overflow-auto" data-consent-cookie></pre>
			</div>
			<div class="flex flex-wrap gap-2">
				<button type="button" class="btn" data-cookie--action="details">Cookie settings</button>
				<button type="button" class="btn btn-danger" data-call="reset">Clear cookie and reload</button>
			</div>
		</div>
	</Scenario>

	<Scenario
		id="banner-dialog"
		title="Banner and details dialog"
		description="The banner is a `data-cookie--alert` element and the settings are a native `<dialog data-cookie--details>`, which the library opens with `showModal()`. Their markup lives here so the panel below shows the wiring; they render over the page."
		expect={[
			"The banner shows until you accept, reject or save. `Close` hides it for this page view only.",
			"`Settings` opens the dialog with the toggles set to the saved choices. Essential is checked and disabled.",
			"`Escape` and `Close` discard unsaved toggle changes. `Save choices` keeps them.",
			"Focus moves into the dialog when it opens and returns to the button that opened it.",
		]}
	>
		<p class="text-[13px] text-muted">
			The banner and dialog render over the page. Open the dialog from here:
		</p>
		<button type="button" class="btn mt-3" data-cookie--action="details">Cookie settings</button>

		<div
			data-cookie--alert
			hidden
			aria-labelledby="cookie-alert-title"
			class="fixed inset-x-4 bottom-16 z-40 lg:left-[calc(15.5rem+2rem)] xl:right-[calc(21rem+2rem)] xl:bottom-6"
		>
			<div class="mx-auto max-w-2xl rounded-xl border border-line-strong/70 bg-panel/95 p-5 shadow-2xl shadow-black/50 backdrop-blur">
				<div class="flex items-start justify-between gap-4">
					<h2 id="cookie-alert-title" class="text-[15px] font-semibold">We use cookies</h2>
					<button type="button" class="btn btn-ghost btn-sm -mt-1 -mr-2" data-cookie--action="dismiss">Close</button>
				</div>
				<p class="mt-1.5 text-[13px] leading-6 text-muted">
					Essential cookies keep the site working. With your permission we'd also
					use analytics and marketing cookies. Read the <a href="#banner-dialog">cookie policy</a>.
				</p>
				<div class="mt-4 flex flex-wrap gap-2">
					<button type="button" class="btn btn-primary" data-cookie--action="accept">Accept all</button>
					<button type="button" class="btn btn-primary" data-cookie--action="reject">Reject all</button>
					<button type="button" class="btn ml-auto" data-cookie--action="details">Settings</button>
				</div>
			</div>
		</div>

		<dialog
			data-cookie--details
			hidden
			aria-labelledby="cookie-details-title"
			class="m-auto max-h-[85dvh] w-[min(34rem,calc(100vw-2rem))] overflow-y-auto rounded-xl border border-line-strong/70 bg-panel p-0 text-fg shadow-2xl shadow-black/60 backdrop:bg-black/60 backdrop:backdrop-blur-[2px]"
		>
			<div class="flex items-start justify-between gap-4 border-b border-line px-6 pt-5 pb-4">
				<div>
					<h2 id="cookie-details-title" class="text-base font-semibold">Cookie settings</h2>
					<p class="mt-1 text-[13px] leading-6 text-muted">Choose which optional cookies we can use. You can change this at any time.</p>
				</div>
				<button type="button" class="btn btn-ghost btn-sm -mr-2" data-cookie--action="dismiss" aria-label="Close without saving">Close</button>
			</div>
			<div class="flex gap-2 px-6 pt-4">
				<button type="button" class="btn flex-1" data-cookie--action="accept">Accept all</button>
				<button type="button" class="btn flex-1" data-cookie--action="reject">Reject all</button>
			</div>
			<ul class="divide-y divide-line px-6 py-2">
				{
					categories.map((category) => (
						<li class="flex items-start gap-4 py-4">
							<div class="flex-1">
								<label for={`cookie-${category.key}`} class="text-sm font-medium">
									{category.title}
								</label>
								<p class="mt-0.5 text-[13px] leading-5 text-muted">{category.description}</p>
								<p class="mt-1.5 font-mono text-[11px] text-subtle">{category.cookies}</p>
							</div>
							<input
								id={`cookie-${category.key}`}
								type="checkbox"
								role="switch"
								class="switch mt-0.5"
								data-cookie--category={category.key}
							/>
						</li>
					))
				}
			</ul>
			<div class="border-t border-line px-6 py-4">
				<button type="button" class="btn btn-primary w-full" data-cookie--action="save">Save choices</button>
			</div>
		</dialog>
	</Scenario>

	<Scenario
		id="methods"
		title="Methods"
		description="Each button calls one method from JavaScript. Consent methods fire `onConsentChange`, which the log shows."
		expect={[
			"`acceptAll` and `rejectAll` set every optional category, close the banner and log type `accept` or `reject`.",
			"`updateConsent` changes one category, keeps the others and logs type `update`.",
			"`getConsent` logs every category, `true` or `false` for marketing, and `undefined` for an unknown category.",
			"After `destroy`, the banner and dialog buttons do nothing. `init` makes them work again and logs type `load`.",
		]}
	>
		<div class="flex flex-wrap gap-2">
			<button type="button" class="btn btn-sm" data-call="acceptAll">acceptAll()</button>
			<button type="button" class="btn btn-sm" data-call="rejectAll">rejectAll()</button>
			<button type="button" class="btn btn-sm" data-call="grantMarketing">updateConsent(&#123; marketing: true &#125;)</button>
			<button type="button" class="btn btn-sm" data-call="withdrawAnalytics">updateConsent(&#123; analytics: false &#125;)</button>
			<button type="button" class="btn btn-sm" data-call="openDetails">openDetails()</button>
			<button type="button" class="btn btn-sm" data-call="getConsent">getConsent()</button>
			<button type="button" class="btn btn-sm" data-call="refresh">refresh()</button>
			<button type="button" class="btn btn-sm btn-danger" data-call="destroy">destroy()</button>
			<button type="button" class="btn btn-sm" data-call="init">init()</button>
		</div>
	</Scenario>

	<Scenario
		id="category-buttons"
		title="Category buttons"
		description="An `accept` or `reject` action with a `data-cookie--category` attribute only updates that category, so an embed placeholder can ask for exactly what it needs."
		expect={[
			"`Allow marketing cookies` grants marketing only, loads the embed below and logs type `update`.",
			"`Not now` withdraws marketing. The embed stays loaded until the page reloads.",
		]}
	>
		<div class="relative overflow-hidden rounded-lg border border-line">
			<iframe
				data-cookie--category="marketing"
				data-cookie--src="/cookie/embed.html"
				title="Embedded content"
				class="peer block h-44 w-full"></iframe>
			<div class="absolute inset-0 grid place-items-center bg-raised px-6 text-center peer-data-[cookie--activated]:hidden">
				<div>
					<p class="text-sm font-medium">This embed needs marketing cookies</p>
					<p class="mt-1 text-[13px] text-muted">Its <code>src</code> is held back until you allow them.</p>
					<div class="mt-4 flex justify-center gap-2">
						<button type="button" class="btn btn-primary btn-sm" data-cookie--action="accept" data-cookie--category="marketing">Allow marketing cookies</button>
						<button type="button" class="btn btn-sm" data-cookie--action="reject" data-cookie--category="marketing">Not now</button>
					</div>
				</div>
			</div>
		</div>
	</Scenario>

	<Scenario
		id="gated-scripts"
		title="Gated scripts"
		description='Scripts with `type="text/plain"` and a `data-cookie--category` stay inert until their categories are consented. Each one reports back here when it runs.'
		expect={[
			"With analytics denied, nothing has run.",
			"Granting analytics runs the inline, module and external scripts, in that order.",
			"`Analytics and marketing` only runs once both are granted.",
			"After a reload with consent saved, they run on load. Withdrawing consent doesn't undo a script that ran.",
		]}
	>
		<ul class="divide-y divide-line text-sm">
			<li class="flex items-center justify-between py-2"><span>Analytics, inline</span><span class={gatePill} data-gate="inline">Waiting</span></li>
			<li class="flex items-center justify-between py-2"><span>Analytics, module (<code>data-cookie--type="module"</code>)</span><span class={gatePill} data-gate="module">Waiting</span></li>
			<li class="flex items-center justify-between py-2"><span>Analytics, external <code>src</code></span><span class={gatePill} data-gate="external">Waiting</span></li>
			<li class="flex items-center justify-between py-2"><span>Analytics and marketing</span><span class={gatePill} data-gate="both">Waiting</span></li>
		</ul>
		<script is:inline type="text/plain" data-cookie--category="analytics">
			window.cookieGate?.("inline");
		</script>
		<script is:inline type="text/plain" data-cookie--type="module" data-cookie--category="analytics">
			window.cookieGate?.("module");
		</script>
		<script is:inline type="text/plain" data-cookie--category="analytics" src="/cookie/analytics.js"></script>
		<script is:inline type="text/plain" data-cookie--category="analytics marketing">
			window.cookieGate?.("both");
		</script>
	</Scenario>

	<Scenario
		id="gated-media"
		title="Gated media and refresh"
		description="Images and iframes use `data-cookie--src` until consented. Activated elements get `data-cookie--activated`, which hides their placeholders here. Media added after `init` needs `refresh()`."
		expect={[
			"The analytics image loads once analytics is granted.",
			"`Add a marketing image` adds one that stays on its placeholder, even with marketing granted, until `refresh()` runs.",
		]}
	>
		<div class="space-y-3">
			<figure class="relative overflow-hidden rounded-md border border-line">
				<img data-cookie--category="analytics" data-cookie--src="/cookie/pixel.svg" alt="Analytics image" width="320" height="120" class="peer block h-24 w-full object-cover" />
				<figcaption class="absolute inset-0 grid place-items-center bg-raised text-xs text-subtle peer-data-[cookie--activated]:hidden">Waiting for analytics consent</figcaption>
			</figure>
			<pg-media class="block space-y-3" data-dynamic-media></pg-media>
			<pg-controls class="flex gap-2">
				<button type="button" class="btn btn-sm" data-add-gated-image>Add a marketing image</button>
				<button type="button" class="btn btn-sm" data-call="refresh">refresh()</button>
			</pg-controls>
		</div>
	</Scenario>

	<Scenario
		id="catalyst-store"
		title="Catalyst store"
		description="`consentStore` from `@lucidclient/cookie-controller/catalyst` is registered as the `consent` store. These bindings read `$granted`, `$denied` and `$decided`, the switches use `data-model`, and the buttons call its actions."
		expect={[
			"The values update with every consent change, from this page's banner, dialog, method buttons and category buttons.",
			"The placeholder shows until marketing is granted, and the marketing content shows once it is.",
			"A switch here saves its category straight away and logs type `update`. The dialog's toggles follow it.",
			"`$decided` is `false` on a first visit and turns `true` after any choice.",
		]}
	>
		<div data-store="consent" class="space-y-4">
			<dl class="grid grid-cols-[10rem_1fr] gap-x-4 gap-y-1.5 text-[13px]">
				<dt class="font-mono text-subtle">$decided</dt>
				<dd class="font-mono" data-dom--text="$decided"></dd>
				<dt class="font-mono text-subtle">$granted.analytics</dt>
				<dd class="font-mono" data-dom--text="$granted.analytics"></dd>
				<dt class="font-mono text-subtle">$granted.marketing</dt>
				<dd class="font-mono" data-dom--text="$granted.marketing"></dd>
				<dt class="font-mono text-subtle">$denied.marketing</dt>
				<dd class="font-mono" data-dom--text="$denied.marketing"></dd>
			</dl>
			<div class="grid gap-2 sm:grid-cols-2">
				<p class="rounded-md bg-raised px-3 py-2.5 text-[13px] text-muted" data-bind--hidden="$granted.marketing">Placeholder: hidden once marketing is granted</p>
				<p class="rounded-md bg-emerald-400/10 px-3 py-2.5 text-[13px] text-emerald-200" data-bind--hidden="$denied.marketing">Marketing content: shown once marketing is granted</p>
			</div>
			<div class="flex flex-wrap gap-6">
				<label class="flex items-center gap-3 text-sm">
					<input type="checkbox" role="switch" class="switch" data-model="$granted.analytics" />
					Analytics
				</label>
				<label class="flex items-center gap-3 text-sm">
					<input type="checkbox" role="switch" class="switch" data-model="$granted.marketing" />
					Marketing
				</label>
			</div>
			<div class="flex flex-wrap gap-2">
				<button type="button" class="btn btn-sm" data-events--click="@acceptAll">@acceptAll</button>
				<button type="button" class="btn btn-sm" data-events--click="@rejectAll">@rejectAll</button>
				<button type="button" class="btn btn-sm" data-events--click="@openDetails">@openDetails</button>
			</div>
		</div>
	</Scenario>

	<Scenario
		id="policy-version"
		title="Policy versions"
		description="Choices saved for another `policyVersion` are ignored, so visitors are asked again. The page reads the version from `?policy=`."
		expect={[
			"Make a choice, then switch to 2.0.0: the banner shows again and the log shows `onPolicyVersionChange` from 1.0.2 to 2.0.0.",
			"The UUID is kept across the version change.",
			"Switching back asks again too, since the cookie now holds 2.0.0.",
		]}
		markup={false}
	>
		<div class="flex flex-wrap items-center gap-2">
			<a class="btn" href="/cookie-controller?policy=1.0.2#policy-version">Use 1.0.2</a>
			<a class="btn" href="/cookie-controller?policy=2.0.0#policy-version">Use 2.0.0</a>
			<span class="ml-2 text-[13px] text-muted">Current: <code data-consent-policy>1.0.2</code></span>
		</div>
	</Scenario>

	<style is:global>
		.switch {
			appearance: none;
			position: relative;
			flex-shrink: 0;
			width: 2.25rem;
			height: 1.25rem;
			border-radius: 9999px;
			background-color: var(--color-line-strong);
			cursor: pointer;
			transition: background-color 150ms;
		}
		.switch::before {
			content: "";
			position: absolute;
			top: 2px;
			left: 2px;
			width: 1rem;
			height: 1rem;
			border-radius: 9999px;
			background-color: var(--color-fg);
			transition: transform 150ms;
		}
		.switch:checked {
			background-color: var(--color-accent-strong);
		}
		.switch:checked::before {
			transform: translateX(1rem);
		}
		.switch:disabled {
			cursor: not-allowed;
			opacity: 0.55;
		}
	</style>

	<script>
		import "../scripts/cookie-controller";
	</script>
</Playground>

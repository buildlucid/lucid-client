---
import Playground from "../layouts/Playground.astro";
import nav from "../nav";
---

<Playground title="Overview" log={false} header={false}>
	<header class="mb-4">
		<p class="text-xs font-medium text-accent">Lucid Client</p>
		<h1 class="mt-2.5 text-[28px] leading-tight font-semibold tracking-tight">
			Playground
		</h1>
		<p class="mt-3 max-w-2xl text-[15px] leading-7 text-muted">
			A test bench for the Lucid Client packages. Every page is a set of
			scenarios: each one says what it covers, what correct behaviour looks
			like, and shows the markup it uses. Actions, effects and library
			warnings appear in the activity log on the right.
		</p>
	</header>

	<div class="surface flex flex-col gap-3 p-4 text-[13px] leading-6 text-muted sm:flex-row sm:items-center sm:gap-5">
		<p class="flex-1">
			Run <code>npm run dev</code> from the repository root. It rebuilds the
			packages as you edit them and serves this playground.
		</p>
		<p class="flex items-center gap-2 text-xs text-subtle">
			<span class="size-1.5 rounded-full bg-amber-400"></span>
			Amber callouts mark known gaps to fix in the packages.
		</p>
	</div>

	{
		nav.map((group) => (
			<section class="rounded-xl border border-line bg-panel">
				<header class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line px-5 py-4 sm:px-6">
					<h2 class="text-[15px] font-semibold tracking-tight">{group.title}</h2>
					<span class="font-mono text-xs text-subtle">
						{group.package}@{group.version}
					</span>
					<p class="w-full text-[13px] leading-6 text-muted">{group.description}</p>
				</header>
				<ul class:list={["grid gap-px bg-line", group.pages.length > 1 && "sm:grid-cols-2"]}>
					{group.pages.map((page) => (
						<li class="bg-panel">
							<a
								href={page.href}
								class="group/card flex h-full flex-col gap-1 px-5 py-4 transition-colors hover:bg-raised/60 sm:px-6"
							>
								<span class="flex items-center gap-2 text-[13px] font-medium text-fg">
									{page.title}
									{page.isNew && (
										<span class="rounded-full bg-accent/15 px-1.5 text-[10px] leading-4 font-semibold text-accent">
											New
										</span>
									)}
									<svg viewBox="0 0 24 24" class="ml-auto size-3.5 text-subtle transition-transform group-hover/card:translate-x-0.5 group-hover/card:text-fg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M5 12h14M13 6l6 6-6 6" />
									</svg>
								</span>
								<span class="text-xs leading-5 text-subtle">{page.description}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Playground>

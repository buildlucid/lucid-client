		"directory": "packages/cookie-controller"
	},
	"keywords": [
		"cookie-consent",
		"cookie-law",
		"gdpr",
		"eu-cookie-law",
		"privacy",
		"consent",
		"javascript",
		"typescript",
		"frontend",
		"minimal",
		"lightweight",
		"lucid-client",
		"lucid"
	],
	"homepage": "https://lucidjs.build/cookie-controller",
	"engines": {
		"node": ">=24 <27"

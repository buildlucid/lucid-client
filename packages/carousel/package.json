{
	"name": "@lucidclient/carousel",
	"version": "0.1.0",
	"private": false,
	"description": "A bring your own markup and styles carousel built on CSS scroll snapping, with JavaScript only for controls, markers, looping, mouse drag, autoplay and accessibility.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": {
				"development": "./dist/dev/index.js",
				"default": "./dist/index.js"
			},
			"require": "./dist/index.cjs"
		},
		"./drag": {
			"types": "./dist/drag.d.ts",
			"import": {
				"development": "./dist/dev/drag.js",
				"default": "./dist/drag.js"
			},
			"require": "./dist/drag.cjs"
		}
	},
	"scripts": {
		"dev": "vp pack --watch"
	},
	"devDependencies": {
		"happy-dom": "^20.11.1",
		"playwright": "1.65.1",
		"vite-plus": "1.7.0",
		"typescript": "^7.0.2"
	},
	"author": "Build Lucid Ltd",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-client.git",
		"directory": "packages/carousel"
	},
	"keywords": [
		"carousel",
		"slider",
		"scroll-snap",
		"progressive-enhancement",
		"accessibility",
		"javascript",
		"typescript",
		"frontend",
		"minimal",
		"lightweight",
		"lucid-client",
		"lucid"
	],
	"homepage": "https://lucidjs.build/carousel",
	"engines": {
		"node": ">=24 <27"
	},
	"volta": {
		"node": "26.13.1"
	}
}

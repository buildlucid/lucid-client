{
	"name": "@lucidclient/catalyst",
	"version": "0.6.0",
	"private": false,
	"description": "An attribute-driven reactive UI runtime powered by SolidJS.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./reactions": {
			"types": "./dist/reactions.d.ts",
			"import": "./dist/reactions.js",
			"require": "./dist/reactions.cjs"
		},
		"./helpers": {
			"types": "./dist/helpers.d.ts",
			"import": "./dist/helpers.js",
			"require": "./dist/helpers.cjs"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/types/index.cjs",
			"default": "./dist/types/index.js"
		}
	},
	"scripts": {
		"dev": "vp pack --watch"
	},
	"devDependencies": {
		"happy-dom": "^20.11.1",
		"typescript": "^7.0.2",
		"vite-plus": "1.7.0"
	},
	"author": "Proto Digital",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ProtoDigitalUK/lucid_client",
		"directory": "packages/catalyst"
	},
	"keywords": [
		"catalyst",
		"ui-library",
		"reactive",
		"solidjs",
		"html-attributes",
		"dom-manipulation",
		"state-management",
		"two-way-binding",
		"javascript",
		"typescript",
		"frontend",
		"minimal",
		"lightweight",
		"lucid-client",
		"lucid"
	],
	"homepage": "https://lucidjs.build/catalyst",
	"engines": {
		"node": ">=24 <27"
	},
	"volta": {
		"node": "26.13.1"
	},
	"dependencies": {
		"solid-js": "^1.9.4"
	}
}

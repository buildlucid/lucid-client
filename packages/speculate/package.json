{
	"name": "@lucidclient/speculate",
	"version": "1.1.2",
	"private": false,
	"description": "Prefetch and prerender links from HTML attributes, using Speculation Rules where the browser supports them and falling back to prefetching on intent where it doesn't.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": {
				"development": "./dist/dev/index.js",
				"default": "./dist/index.js"
			},
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"dev": "vp pack --watch"
	},
	"devDependencies": {
		"happy-dom": "^20.11.1",
		"typescript": "^7.0.2",
		"vite-plus": "1.7.0"
	},
	"author": "Build Lucid Ltd",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buildlucid/lucid-client.git",
		"directory": "packages/speculate"
	},
	"homepage": "https://lucidjs.build/speculate",
	"license": "MIT",
	"keywords": [
		"prefetch",
		"prerender",
		"speculation rules",
		"lucid-client",
		"lucid"
	],
	"engines": {
		"node": ">=24 <27"
	},
	"volta": {
		"node": "26.13.1"
	}
}
